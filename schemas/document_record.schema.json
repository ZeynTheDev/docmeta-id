{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocMeta-ID Document Record",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "file_name",
    "document_family",
    "document_type",
    "source_id",
    "template_group_id",
    "document_numbers",
    "document_subject",
    "subject_source_field",
    "annotation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{4,}$"
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "document_family": {
      "type": "string",
      "enum": [
        "correspondence",
        "regulation",
        "decision"
      ]
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "template_group_id": {
      "type": "string",
      "minLength": 1
    },
    "issuing_authorities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "document_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "document_subject": {
      "type": "string",
      "minLength": 1
    },
    "subject_source_field": {
      "type": "string",
      "enum": [
        "PERIHAL",
        "HAL",
        "TENTANG",
        "JUDUL",
        "OTHER"
      ]
    },
    "document_number_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "source_line"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "source_line": {
            "type": "string"
          },
          "issuer_label": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "image_metadata": {
      "type": "object",
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": ["integer", "null"]
        },
        "height": {
          "type": ["integer", "null"]
        },
        "format": {
          "type": "string"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "annotator_id",
        "verification_status",
        "guideline_version"
      ],
      "properties": {
        "annotator_id": {
          "type": "string"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "pending",
            "human_verified",
            "adjudicated"
          ]
        },
        "guideline_version": {
          "type": "string"
        }
      }
    }
  }
}

